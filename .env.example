# Leave empty on Vercel — the app then calls the same-origin serverless proxy
# at /api/* (see api/[...slug].js), which fetches from InfinityFree with a
# browser User-Agent (bypasses their anti-bot CORS block).
VITE_API_BASE=

# For local development, this file is not used; src/api.js defaults to
# http://localhost:8000. To point at a different backend, set:
# VITE_API_BASE=https://yanphayuporfolio.42web.io
